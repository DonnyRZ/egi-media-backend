# Application
# APP_HOST must include protocol + host + port — used as Google OAuth callback base.
APP_HOST=http://localhost:5002
APP_ENV=development
APP_PORT=5002
FE_URL=http://localhost:3000

# CORS
CORS_ORIGINS=http://localhost:3000

# Database
POSTGRESQL_URL=postgresql://postgres:postgres@localhost:5432/sample
CRAWL_API_URL=http://127.0.0.1:5050

# JWT Secret
ACCESS_TOKEN_SECRET=your-key
REFRESH_TOKEN_SECRET=your-key
# Access token lifetime (client also receives matching expires_in seconds).
ACCESS_SIGN_OPTIONS='{"expiresIn": "7d"}'
# Refresh token lifetime — used to silently renew access tokens for active users.
REFRESH_SIGN_OPTIONS='{"expiresIn": "30d"}'

# BASIC AUTH
USERNAME_BASIC=your_basic
PASSWORD_BASIC=your_basic

# GOOGLE OAUTH 2.0
# Authorized redirect URI in Google Cloud Console must exactly match:
#   {APP_HOST}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your_id
GOOGLE_SECRET_KEY=your_secret

# Redis
REDIS_URL=redis://localhost:6379

# Cloudflare R2 Object Storage
R2_ENDPOINT_S3_CLIENT=your_endpoint_s3
R2_USER_API_TOKEN=your_token
R2_ACCESS_S3_USER=your_user
R2_SECRET_S3_USER=your_secret
R2_BUCKET_NAME=your-bucket-name
# Public base URL for uploaded objects (r2.dev or custom domain, no trailing slash)
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Mail / SMTP Configuration (REQUIRED for publish email alerts)
# Prefer SMTP_*; MAIL_* aliases still work as fallback.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM="EGI Media <noreply@egimedia.com>"
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Legacy aliases (optional — used only if matching SMTP_* is empty)
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_FROM=
MAIL_USER=
MAIL_PASS=

# Encryption Data
ENCRYPTION_KEY=your-key

# AI Translation (OpenAI-compatible Chat Completions)
# Used to auto-translate Indonesian articles to English and Uzbek on create/update.
AI_ENABLED=true
AI_API_KEY=your-openai-compatible-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1
